# Public ports on EC2
BACKEND_PORT=5000
FRONTEND_PORT=80
N8N_PORT=5678

# Postgres
POSTGRES_DB=styleflow
POSTGRES_USER=styleflow_user
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=require

# Public HTTPS origins behind reverse proxy
WEB_ORIGIN=https://ecloria.co.uk
VITE_API_BASE_URL=https://api.ecloria.co.uk
JWT_SECRET=generate_a_strong_random_secret
INTERNAL_WEBHOOK_SECRET=generate_a_strong_internal_webhook_secret

# n8n
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
N8N_HOST=n8n.ecloria.co.uk
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.ecloria.co.uk
WEBHOOK_URL=https://n8n.ecloria.co.uk/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=styleflow-assets
R2_PUBLIC_BASE_URL=https://assets.ecloria.co.uk
LOCATION_API_BASE_URL=https://provinces.open-api.vn
LOCATION_CACHE_TTL_MS=43200000

# MoMo payment gateway
# Sandbox create endpoint: https://test-payment.momo.vn/v2/gateway/api/create
# Production create endpoint: https://payment.momo.vn/v2/gateway/api/create
PUBLIC_API_BASE_URL=https://api.ecloria.co.uk
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_STORE_ID=ECLORIA
MOMO_REDIRECT_URL=https://ecloria.co.uk
MOMO_IPN_URL=https://api.ecloria.co.uk/payments/momo/ipn
MOMO_PAYMENT_EXPIRY_MINUTES=15
