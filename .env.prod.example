# Public ports on EC2
BACKEND_PORT=5000
FRONTEND_PORT=80
N8N_PORT=5678

# Postgres
POSTGRES_DB=styleflow
POSTGRES_USER=styleflow_user
POSTGRES_PASSWORD=change_me_strong_password

# Web/backend origins
WEB_ORIGIN=http://YOUR_EC2_PUBLIC_IP
VITE_API_BASE_URL=http://YOUR_EC2_PUBLIC_IP:5000

# n8n
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
N8N_HOST=YOUR_EC2_PUBLIC_IP
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://YOUR_EC2_PUBLIC_IP:5678
WEBHOOK_URL=http://YOUR_EC2_PUBLIC_IP:5678/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
