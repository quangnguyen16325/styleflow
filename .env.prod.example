# Public ports on EC2
BACKEND_PORT=5000
FRONTEND_PORT=80
N8N_PORT=5678

# Postgres
POSTGRES_DB=styleflow
POSTGRES_USER=styleflow_user
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=require

# Public HTTPS origins behind reverse proxy
WEB_ORIGIN=https://ecloria.co.uk
VITE_API_BASE_URL=https://api.ecloria.co.uk

# n8n
N8N_ENCRYPTION_KEY=generate_with_openssl_rand_hex_32
N8N_HOST=n8n.ecloria.co.uk
N8N_PROTOCOL=https
N8N_EDITOR_BASE_URL=https://n8n.ecloria.co.uk
WEBHOOK_URL=https://n8n.ecloria.co.uk/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
